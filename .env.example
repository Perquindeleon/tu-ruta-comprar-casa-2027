# ===================================================================
# TU RUTA PARA COMPRAR CASA EN 2027 — VARIABLES DE ENTORNO DE EJEMPLO
# Proyecto: Perquin de León
# ===================================================================
# IMPORTANTE: Nunca subas tus claves secretas a GitHub. 
# Configura estas variables en el panel de Cloudflare Pages:
# Settings > Environment Variables (Production & Preview)

# 1. SERVICIO DE CORREO (RESEND)
# Regístrate gratis en https://resend.com y obtén tu API Key en el panel
RESEND_API_KEY=re_tu_clave_secreta_aqui

# Dirección del remitente autorizada en Resend.
# Para pruebas puedes usar: onboarding@resend.dev
# Para producción verifica tu propio dominio (ej. Perquin de León <hola@tudominio.com>)
EMAIL_FROM="Perquin de León <onboarding@resend.dev>"

# 2. PROTECCIÓN CONTRA BOTS (CLOUDFLARE TURNSTILE - OPCIONAL PARA PRODUCCIÓN)
# Si deseas añadir validación de captcha invisible de Cloudflare:
TURNSTILE_SITE_KEY=tu_turnstile_site_key_aqui
TURNSTILE_SECRET_KEY=tu_turnstile_secret_key_aqui
